<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.grpc.core.repository.OrderRepository">
    <resultMap id="OrderResultMap" type="com.example.grpc.core.entity.OrderEntity">
        <id property="id" column="order_id"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <collection property="items" ofType="com.example.grpc.core.entity.OrderItemEntity">
            <result property="itemName" column="item_name"/>
        </collection>
    </resultMap>

    <insert id="insertOrder">
        INSERT INTO orders (id, user_id, total_amount, status)
        VALUES (#{id}, #{userId}, #{totalAmount}, #{status})
    </insert>

    <select id="findById" resultMap="OrderResultMap">
        SELECT o.id as order_id, o.user_id, o.total_amount, o.status, i.item_name
        FROM orders o
        LEFT JOIN order_items i ON o.id = i.order_id
        WHERE o.id = #{id}
    </select>


    <insert id="insertOrderItems" parameterType="java.util.List">
        INSERT INTO order_items (order_id, item_name , price)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.itemName}, #{item.price})
        </foreach>
    </insert>


</mapper>